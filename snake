<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>NEON SNAKE</title>
<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  min-height: 100vh;
  background: #050807;
  color: #00ff88;
  font-family: Arial, sans-serif;
  display: flex;
  justify-content: center;
  align-items: center;
}

.game {
  text-align: center;
  padding: 20px;
  width: min(100%, 540px);
}

h1 {
  font-size: 38px;
  letter-spacing: 5px;
  text-shadow: 0 0 12px #00ff88;
}

.stats {
  display: flex;
  justify-content: space-between;
  margin: 16px 0;
  font-size: 17px;
}

canvas {
  width: 100%;
  height: auto;
  border: 2px solid #00ff88;
  border-radius: 8px;
  box-shadow: 0 0 20px #00ff8844;
  background: #07100d;
}

button {
  background: #00ff88;
  color: #031009;
  border: none;
  padding: 12px 22px;
  margin: 12px 5px;
  font-weight: bold;
  font-size: 15px;
  border-radius: 7px;
  cursor: pointer;
}

button:hover { box-shadow: 0 0 15px #00ff88; }

p { color: #a1b8ac; font-size: 13px; }

</style>
</head>
<body>
<div class="game">
  <h1>NEON SNAKE</h1>
  <div class="stats">
    <span>WYNIK: <b id="score">0</b></span>
    <span>REKORD: <b id="best">0</b></span>
  </div>

  <canvas id="board" width="480" height="480"></canvas>

  <div>
    <button id="start">START / RESTART</button>
  </div>
  <p>Sterowanie: strzałki lub W A S D</p>
  <p id="message">Kliknij START, żeby zagrać.</p>
</div>

<script>
const canvas = document.getElementById("board");
const ctx = canvas.getContext("2d");
const size = 24;
const cells = 20;

let snake, food, dx, dy, score, timer;
let running = false;
let ended = false;
let best = 0;

try {
  best = Number(localStorage.getItem("neonSnakeBest")) || 0;
} catch (e) {}

document.getElementById("best").textContent = best;

function placeFood() {
  do {
    food = {
      x: Math.floor(Math.random() * cells),
      y: Math.floor(Math.random() * cells)
    };
  } while (snake.some(s => s.x === food.x && s.y === food.y));
}

function reset() {
  clearInterval(timer);
  snake = [
    {x: 9, y: 10},
    {x: 8, y: 10},
    {x: 7, y: 10}
  ];
  dx = 1;
  dy = 0;
  score = 0;
  running = true;
  ended = false;
  document.getElementById("score").textContent = score;
  document.getElementById("message").textContent = "Łap jedzenie!";
  placeFood();
  draw();
  timer = setInterval(update, 115);
}

function draw() {
  ctx.fillStyle = "#07100d";
  ctx.fillRect(0, 0, 480, 480);

  ctx.strokeStyle = "#10251b";
  ctx.lineWidth = 1;
  for (let i = 0; i <= 480; i += size) {
    ctx.beginPath();
    ctx.moveTo(i, 0);
    ctx.lineTo(i, 480);
    ctx.stroke();
    ctx.beginPath();
    ctx.moveTo(0, i);
    ctx.lineTo(480, i);
    ctx.stroke();
  }

  ctx.save();
  ctx.shadowColor = "#ff267f";
  ctx.shadowBlur = 18;
  ctx.fillStyle = "#ff267f";
  ctx.beginPath();
  ctx.arc(food.x * size + 12, food.y * size + 12, 8, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  snake.forEach((part, i) => {
    ctx.save();
    ctx.shadowColor = "#00ff88";
    ctx.shadowBlur = i === 0 ? 20 : 10;
    ctx.fillStyle = i === 0 ? "#c4ffdf" : "#00e676";
    ctx.fillRect(
      part.x * size + 2,
      part.y * size + 2,
      size - 4,
      size - 4
    );
    ctx.restore();
  });
}

function update() {
  if (!running) return;

  const head = {x: snake[0].x + dx, y: snake[0].y + dy};
  const ate = head.x === food.x && head.y === food.y;

  const hitWall =
    head.x < 0 || head.x >= cells ||
    head.y < 0 || head.y >= cells;

  const body = ate ? snake : snake.slice(0, -1);
  const hitSelf = body.some(s => s.x === head.x && s.y === head.y);

  if (hitWall || hitSelf) {
    running = false;
    ended = true;
    clearInterval(timer);
    document.getElementById("message").textContent =
      "KONIEC GRY! Kliknij START, żeby spróbować ponownie.";
    draw();
    return;
  }

  snake.unshift(head);

  if (ate) {
    score += 10;
    document.getElementById("score").textContent = score;

    if (score > best) {
      best = score;
      document.getElementById("best").textContent = best;
      try {
        localStorage.setItem("neonSnakeBest", best);
      } catch (e) {}
    }

    if (snake.length === cells * cells) {
      running = false;
      clearInterval(timer);
      document.getElementById("message").textContent =
        "NIESAMOWITE! WYPEŁNIŁEŚ CAŁĄ PLANSZĘ!";
      draw();
      return;
    }

    placeFood();
  } else {
    snake.pop();
  }

  draw();
}

document.addEventListener("keydown", e => {
  const keys = {
    ArrowUp: [0, -1],
    w: [0, -1], W: [0, -1],
    ArrowDown: [0, 1],
    s: [0, 1], S: [0, 1],
    ArrowLeft: [-1, 0],
    a: [-1, 0], A: [-1, 0],
    ArrowRight: [1, 0],
    d: [1, 0], D: [1, 0]
  };

  const dir = keys[e.key];
  if (!dir) return;
  e.preventDefault();

  if (running && dir[0] === -dx && dir[1] === -dy) return;
  if (dir[0] !== 0 || dir[1] !== 0) {
    dx = dir[0];
    dy = dir[1];
  }
});

document.getElementById("start").addEventListener("click", reset);

snake = [
  {x: 9, y: 10},
  {x: 8, y: 10},
  {x: 7, y: 10}
];
placeFood();
draw();
</script>
</body>
</html>
